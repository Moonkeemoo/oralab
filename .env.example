# ─── Polymarket signing (P1 solo — Taras only) ──────────────────────────────
POLY_PRIVATE_KEY=0x
POLY_WALLET_ADDRESS=0xba462127e57124acf907f00f87543805d9e7ae62

# ─── CLOB API auth ──────────────────────────────────────────────────────────
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ─── Network (Polygon mainnet, CLOB V2) ─────────────────────────────────────
CHAIN_ID=137
CLOB_URL=https://clob.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
SPORTS_WS_URL=wss://sports-api.polymarket.com/ws
RTDS_WS_URL=wss://ws-live-data.polymarket.com

# Polymarket WS endpoints
CLOB_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# ─── RPC fallbacks (chain listener) ─────────────────────────────────────────
POLYGON_RPC_URLS=https://polygon-rpc.com,https://rpc-mainnet.matic.network
POLYGON_WS_URLS=

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ora:ora@localhost:5433/ora_v2

# ─── Telegram (P2 entry point; P1 alerts via solo chat_id) ──────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=61804306
TELEGRAM_ALLOWED_CHAT_IDS=61804306
TELEGRAM_PUBLIC_CHAT_ID=

# ─── Observability (OTEL → Prometheus + Loki + Grafana on Hetzner) ──────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ora2-trader

# ─── Trading modes ──────────────────────────────────────────────────────────
DRY_RUN=true
KILL_SWITCH=false

# ─── P3c multi-user (placeholder; activates at week 11+) ────────────────────
# CUSTODIAL_MASTER_KEY=
